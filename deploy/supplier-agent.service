[Unit]
Description=Supplier Comparison Agent (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
# One LLM call takes 20-40 s and the gateway client may back off on 403s,
# so the worker timeout must be well above that.
ExecStart=__APP_DIR__/.venv/bin/gunicorn --workers 2 --threads 4 --timeout 180 --bind 127.0.0.1:8080 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
